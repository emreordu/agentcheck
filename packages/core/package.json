{
  "name": "@agentcheck/core",
  "version": "0.1.0",
  "description": "Core checkpoint, change-detection, and deterministic analysis engine for AgentCheck.",
  "license": "Apache-2.0",
  "keywords": [
    "coding-agents",
    "developer-tools",
    "git",
    "local-first",
    "verification"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build && node ../../scripts/prepare-package-docs.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/checkpoint.test.js .test-dist/analyzer.test.js .test-dist/m4.test.js .test-dist/adversarial.test.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "author": "emreordu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emreordu/agentcheck.git"
  },
  "homepage": "https://github.com/emreordu/agentcheck#readme",
  "bugs": {
    "url": "https://github.com/emreordu/agentcheck/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
