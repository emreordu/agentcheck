{
  "name": "@agentcheck/cli",
  "version": "0.1.1",
  "description": "Deterministic, local-first verification of coding-agent changes before you commit.",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "coding-agents",
    "ai-assisted-development",
    "code-review",
    "developer-tools",
    "git",
    "local-first",
    "verification"
  ],
  "type": "module",
  "bin": {
    "agentcheck": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build && node ../../scripts/prepare-package-docs.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/cli.test.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@agentcheck/core": "0.1.1"
  },
  "author": "emreordu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emreordu/agentcheck.git"
  },
  "homepage": "https://github.com/emreordu/agentcheck#readme",
  "bugs": {
    "url": "https://github.com/emreordu/agentcheck/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
